async function sendNormalMediaToOwner(message) {
  if (!sock || !mediaForwardEnabled) return false;

  const original = unwrapQuoted(message);

  if (!original || !hasMedia(original)) {
    return false;
  }

  if (isViewOnce(original)) {
    console.log("View Once media ignored");
    return false;
  }

  try {
    const fakeMessage = {
      key: message.key,
      message: original
    };

    const buffer = await downloadMediaMessage(
      fakeMessage,
      "buffer",
      {},
      {
        logger: pino({ level: "silent" })
      }
    );

    if (original.imageMessage) {
      await sock.sendMessage(ownerJid(), {
        image: buffer,
        caption: original.imageMessage.caption || ""
      });
    } else if (original.videoMessage) {
      await sock.sendMessage(ownerJid(), {
        video: buffer,
        caption: original.videoMessage.caption || "",
        mimetype: original.videoMessage.mimetype
      });
    } else if (original.audioMessage) {
      await sock.sendMessage(ownerJid(), {
        audio: buffer,
        mimetype: original.audioMessage.mimetype,
        ptt: Boolean(original.audioMessage.ptt)
      });
    } else if (original.documentMessage) {
      await sock.sendMessage(ownerJid(), {
        document: buffer,
        mimetype: original.documentMessage.mimetype,
        fileName: original.documentMessage.fileName || "file"
      });
    } else if (original.stickerMessage) {
      await sock.sendMessage(ownerJid(), {
        sticker: buffer
      });
    } else {
      return false;
    }

    return true;
  } catch (error) {
    console.error("Media forwarding error:", error.message);
    return false;
  }
}

async function handleCommand(message, jid, text) {
  if (!isOwner(jid)) return false;

  const command = text.toLowerCase();

  if (command === ".vv") {
    const quoted = getQuotedMessage(message);

    if (!quoted) {
      await sock.sendMessage(jid, {
        text: "reply garee normal media kadib .vv qor"
      });
      return true;
    }

    if (isViewOnce(quoted)) {
      await sock.sendMessage(jid, {
        text: "View Once lama soo celin karo"
      });
      return true;
    }

    if (!hasMedia(quoted)) {
      await sock.sendMessage(jid, {
        text: "normal media reply garee kadib .vv qor"
      });
      return true;
    }

    const fake = {
      key: message.key,
      message: quoted
    };

    try {
      const buffer = await downloadMediaMessage(
        fake,
        "buffer",
        {},
        {
          logger: pino({ level: "silent" })
        }
      );

      if (quoted.imageMessage) {
        await sock.sendMessage(ownerJid(), {
          image: buffer,
          caption: quoted.imageMessage.caption || ""
        });
      } else if (quoted.videoMessage) {
        await sock.sendMessage(ownerJid(), {
          video: buffer,
          caption: quoted.videoMessage.caption || "",
          mimetype: quoted.videoMessage.mimetype
        });
      } else if (quoted.audioMessage) {
        await sock.sendMessage(ownerJid(), {
          audio: buffer,
          mimetype: quoted.audioMessage.mimetype,
          ptt: Boolean(quoted.audioMessage.ptt)
        });
      } else if (quoted.documentMessage) {
        await sock.sendMessage(ownerJid(), {
          document: buffer,
          mimetype: quoted.documentMessage.mimetype,
          fileName: quoted.documentMessage.fileName || "file"
        });
      } else if (quoted.stickerMessage) {
        await sock.sendMessage(ownerJid(), {
          sticker: buffer
        });
      }

      await sock.sendMessage(jid, {
        text: "waa la diray"
      });
    } catch (error) {
      console.error(".vv error:", error.message);

      await sock.sendMessage(jid, {
        text: "media-ga lama diri karin"
      });
    }

    return true;
  }

  if (command === "send") {
    const quoted = getQuotedMessage(message);

    if (!quoted) {
      await sock.sendMessage(jid, {
        text: "reply garee normal status media kadib send qor"
      });
      return true;
    }

    if (isViewOnce(quoted)) {
      await sock.sendMessage(jid, {
        text: "View Once lama soo celin karo"
      });
      return true;
    }

    if (!hasMedia(quoted)) {
      await sock.sendMessage(jid, {
        text: "normal status media reply garee kadib send qor"
      });
      return true;
    }

    const ok = await sendNormalMediaToOwner(message);

    await sock.sendMessage(jid, {
      text: ok ? "waa la diray" : "media-ga lama diri karin"
    });

    return true;
  }

  return false;
}

async function startBot() {
  const { state, saveCreds } = await useMultiFileAuthState("./auth");

  sock = makeWASocket({
    auth: state,
    printQRInTerminal: false,
    logger: pino({ level: "silent" }),
    browser: ["Somali WhatsApp Bot", "Chrome", "1.0.0"]
  });

  sock.ev.on("creds.update", saveCreds);

  sock.ev.on("connection.update", async (update) => {
    const { connection, lastDisconnect } = update;

    if (connection === "open") {
      connected = true;
      pairingRequested = false;

      console.log("WhatsApp connected");
    }

    if (connection === "close") {
      connected = false;

      const statusCode =
        lastDisconnect?.error?.output?.statusCode;

      console.log("WhatsApp disconnected", statusCode);

      if (statusCode !== DisconnectReason.loggedOut) {
        setTimeout(() => {
          startBot().catch(console.error);
        }, 5000);
      } else {
        console.log("WhatsApp logged out");
      }
    }

    if (
      !state.creds.registered &&
      !pairingRequested
    ) {
      pairingRequested = true;

      try {
        const code = await sock.requestPairingCode(PAIRING_NUMBER);

        console.log("");
        console.log("================================");
        console.log("WHATSAPP PAIRING CODE");
        console.log(code);
        console.log("================================");
        console.log("");
      } catch (error) {
        pairingRequested = false;
        console.error("Pairing code error:", error.message);
      }
    }
  });

  sock.ev.on("messages.upsert", async ({ messages }) => {
    for (const message of messages) {
      try {
        if (!message.message) continue;

        const jid = message.key.remoteJid;

        if (!jid) continue;

        if (isGroup(jid)) continue;
        if (isBroadcast(jid)) continue;

        const text = getText(message.message);

        if (!text) continue;

        // Owner commands must work even when message.key.fromMe is true
        if (message.key.fromMe && isOwner(jid)) {
          await handleCommand(message.message, jid, text);
          continue;
        }

        // Never auto reply to our own messages
        if (message.key.fromMe) continue;

        if (
          text.toLowerCase() === ".vv" ||
          text.toLowerCase() === "send"
        ) {
          continue;
        }

        if (!autoReplyEnabled) continue;

        if (!canReply(jid)) continue;

        const reply = findAutoReply(text);

        if (!reply) continue;

        await sock.sendMessage(jid, {
          text: reply
        });
      } catch (error) {
        console.error("Message handler error:", error.message);
      }
    }
  });
}

startBot().catch((error) => {
  console.error("Bot startup error:", error);
  process.exit(1);
});
