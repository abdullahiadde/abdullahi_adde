const cooldowns = new Map();

function cleanNumber(value) {
  return String(value || "").replace(/\D/g, "");
}

function ownerJid() {
  return `${OWNER_NUMBER}@s.whatsapp.net`;
}

function isOwner(jid) {
  if (!jid) return false;

  const number = cleanNumber(String(jid).split("@")[0]);

  return number === OWNER_NUMBER;
}

function isGroup(jid) {
  return String(jid || "").endsWith("@g.us");
}

function isBroadcast(jid) {
  return (
    String(jid || "").endsWith("@broadcast") ||
    String(jid || "").includes("status@broadcast")
  );
}

function getText(message) {
  return (
    message?.conversation ||
    message?.extendedTextMessage?.text ||
    message?.imageMessage?.caption ||
    message?.videoMessage?.caption ||
    message?.documentMessage?.caption ||
    ""
  ).trim();
}

function getQuotedMessage(message) {
  return message?.extendedTextMessage?.contextInfo?.quotedMessage || null;
}

function hasMedia(message) {
  if (!message) return false;

  return Boolean(
    message.imageMessage ||
    message.videoMessage ||
    message.audioMessage ||
    message.documentMessage ||
    message.stickerMessage
  );
}

function isViewOnce(message) {
  if (!message) return false;

  return Boolean(
    message.viewOnceMessage ||
    message.viewOnceMessageV2 ||
    message.viewOnceMessageV2Extension ||
    message.imageMessage?.viewOnce ||
    message.videoMessage?.viewOnce
  );
}

function unwrapQuoted(message) {
  if (!message) return null;

  if (message.ephemeralMessage?.message) {
    return unwrapQuoted(message.ephemeralMessage.message);
  }

  if (message.viewOnceMessage?.message) {
    return message.viewOnceMessage.message;
  }

  if (message.viewOnceMessageV2?.message) {
    return message.viewOnceMessageV2.message;
  }

  if (message.viewOnceMessageV2Extension?.message) {
    return message.viewOnceMessageV2Extension.message;
  }

  return message;
}

